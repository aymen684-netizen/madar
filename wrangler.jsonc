{
  "name": "madar",
  "main": "build/release/worker/index.js",
  "no_bundle": true,
  "build": {
    "command": "node scripts/verify-release.mjs --reviewed"
  },
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./build/release/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "ORBIT_LIMITER",
      "namespace_id": "784392",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "previews": {
    "ratelimits": [
      {
        "name": "ORBIT_LIMITER",
        "namespace_id": "784393",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ]
  }
}
