{
  "name": "madar",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "ORBIT_LIMITER",
      "namespace_id": "784392",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
